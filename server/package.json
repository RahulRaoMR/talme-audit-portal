{
  "name": "talme-employee-audit-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test src/utils/passwordResetSecurity.test.ts src/utils/employeeSchemas.test.ts src/utils/monthlyReportRules.test.ts src/utils/quarterlyReportRules.test.ts src/utils/auditRules.test.ts",
    "test:audit-api": "tsx scripts/verify-audit-migration.ts",
    "test:audit-ui": "tsx scripts/verify-audit-ui.ts",
    "audit:import-template": "tsx scripts/import-capa-template.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "tsx scripts/prisma.ts generate",
    "prisma:deploy": "tsx scripts/prisma.ts migrate deploy",
    "prisma:migrate": "tsx scripts/prisma.ts migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:verify": "tsx scripts/verify-neon.ts",
    "db:setup": "npm run prisma:generate && npm run db:check -- --connection-only && npm run prisma:deploy && npm run prisma:seed && npm run db:check",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
