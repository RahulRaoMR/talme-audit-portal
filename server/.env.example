# Neon writes DATABASE_URL and DATABASE_URL_UNPOOLED into the root .env.local.
# This server loads that file before server/.env. Keep database credentials there.
# DATABASE_URL is pooled; DATABASE_URL_UNPOOLED is direct and used by Prisma Migrate.

JWT_SECRET="replace-with-a-long-random-secret"
PASSWORD_RESET_JWT_SECRET="replace-with-a-different-long-random-secret"
PASSWORD_RESET_OTP_SECRET="replace-with-another-long-random-secret"
PORT=4000
CLIENT_ORIGINS="http://localhost:5173,http://localhost:5174"

SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Talme Technologies <no-reply@talme.com>"
