generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Department {
  id             String           @id @default(cuid())
  name           String           @unique
  code           String           @unique
  description    String?
  isActive       Boolean          @default(true)
  employees      Employee[]
  kpis           Kpi[]
  internalAudits InternalAudit[]
  auditFindings  AuditFinding[]
  capaActions    CapaActionItem[]
  risks          RiskAssessment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([isActive])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  users       User[]
}

model User {
  id                              String                         @id @default(cuid())
  email                           String                         @unique
  passwordHash                    String
  roleId                          String
  role                            Role                           @relation(fields: [roleId], references: [id])
  employeeId                      String?                        @unique
  employee                        Employee?                      @relation(fields: [employeeId], references: [id])
  passwordResetOtps               PasswordResetOtp[]
  reviewedMonthlyReports          MonthlyReport[]                @relation("MonthlyReportReviewer")
  monthlyReportActions            MonthlyReportActionHistory[]
  monthlyReportUploads            MonthlyReportAttachment[]
  managerReviewedQuarterlyReports QuarterlyReport[]              @relation("QuarterlyManagerReviewer")
  hrReviewedQuarterlyReports      QuarterlyReport[]              @relation("QuarterlyHrReviewer")
  quarterlyReportActions          QuarterlyReportActionHistory[]
  auditsCreated                   InternalAudit[]                @relation("AuditCreator")
  auditsLed                       InternalAudit[]                @relation("AuditLead")
  auditTeams                      AuditTeamMember[]
  capasPrepared                   Capa[]                         @relation("CapaPreparer")
  capasReviewed                   Capa[]                         @relation("CapaReviewer")
  capasVerified                   Capa[]                         @relation("CapaVerifier")
  capasClosed                     Capa[]                         @relation("CapaCloser")
  actionVerifications             CapaActionItem[]               @relation("ActionVerifier")
  capaVerifications               CapaVerification[]
  evidenceReviews                 MonthlyReportAttachment[]      @relation("EvidenceReviewer")
  notifications                   PortalNotification[]
  risksCreated                    RiskAssessment[]               @relation("RiskCreator")
  risksReviewed                   RiskAssessment[]               @relation("RiskReviewer")
  risksClosed                     RiskAssessment[]               @relation("RiskCloser")
  riskScoringUpdates              RiskScoringConfiguration[]
  isActive                        Boolean                        @default(true)
  mustChangePassword              Boolean                        @default(true)
  passwordChangedAt               DateTime?
  lastLoginAt                     DateTime?
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt

  @@index([roleId])
  @@index([isActive])
}

model PasswordResetOtp {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash      String
  expiresAt    DateTime  @db.Timestamptz(3)
  verifiedAt   DateTime? @db.Timestamptz(3)
  usedAt       DateTime? @db.Timestamptz(3)
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, usedAt, createdAt])
  @@index([expiresAt])
}

model Employee {
  id                  String            @id @default(cuid())
  employeeCode        String            @unique
  firstName           String
  lastName            String
  email               String            @unique
  phone               String?
  departmentId        String
  department          Department        @relation(fields: [departmentId], references: [id])
  designation         String
  managerId           String?
  manager             Employee?         @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports       Employee[]        @relation("EmployeeManager")
  joiningDate         DateTime
  employmentStatus    String
  user                User?
  monthlyReports      MonthlyReport[]
  quarterlyReports    QuarterlyReport[]
  assignedFindings    AuditFinding[]
  assignedCapaActions CapaActionItem[]
  assignedRisks       RiskAssessment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
}

enum MonthlyReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

enum MonthlyReportAction {
  CREATED
  UPDATED
  SUBMITTED
  RETURNED
  RESUBMITTED
  APPROVED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  AUDIT_CREATED
  AUDIT_UPDATED
  AUDIT_STATUS_CHANGED
  AUDITOR_ASSIGNED
  FINDING_CREATED
  FINDING_UPDATED
  FINDING_CLOSED
  CAPA_UPDATED
  CAPA_SUBMITTED
  CAPA_REVIEW_STARTED
  CAPA_ACCEPTED
  CAPA_RETURNED
  ACTION_CREATED
  ACTION_UPDATED
  ACTION_COMPLETED
  ACTION_VERIFIED
  ACTION_REJECTED
  EVIDENCE_REVIEWED
  VERIFICATION_REQUESTED
  CAPA_VERIFIED
  VERIFICATION_REJECTED
  COMMENT_ADDED
  AUDIT_CLOSED
  AUDIT_REOPENED
  RISK_CREATED
  RISK_UPDATED
  RISK_SCORE_CHANGED
  RISK_MITIGATION_UPDATED
  RISK_OWNER_CHANGED
  RISK_STATUS_CHANGED
  RISK_REVIEWED
  RISK_CLOSED
  RISK_REOPENED
  RISK_SCORING_CONFIGURED
}

model MonthlyReport {
  id                String                        @id @default(cuid())
  employeeId        String
  employee          Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month             Int
  year              Int
  reportPeriod      String
  status            MonthlyReportStatus           @default(DRAFT)
  summary           String
  achievements      String
  challenges        String
  pendingWork       String
  nextMonthPlan     String
  employeeComments  String?
  managerComments   String?
  submittedAt       DateTime?                     @db.Timestamptz(3)
  reviewedAt        DateTime?                     @db.Timestamptz(3)
  reviewedById      String?
  reviewedBy        User?                         @relation("MonthlyReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  hrDetail          HrMonthlyReportDetail?
  developerDetail   DeveloperMonthlyReportDetail?
  payrollDetail     PayrollMonthlyReportDetail?
  attachments       MonthlyReportAttachment[]
  history           MonthlyReportActionHistory[]
  quarterlyAsFirst  QuarterlyReport[]             @relation("QuarterlyMonth1")
  quarterlyAsSecond QuarterlyReport[]             @relation("QuarterlyMonth2")
  quarterlyAsThird  QuarterlyReport[]             @relation("QuarterlyMonth3")
  createdAt         DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                      @updatedAt @db.Timestamptz(3)

  @@unique([employeeId, month, year])
  @@index([status, year, month])
  @@index([reviewedById])
}

model HrMonthlyReportDetail {
  id                     String        @id @default(cuid())
  monthlyReportId        String        @unique
  monthlyReport          MonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  openPositions          Int           @default(0)
  positionsClosed        Int           @default(0)
  candidatesInterviewed  Int           @default(0)
  employeesOnboarded     Int           @default(0)
  documentsCompleted     Int           @default(0)
  documentsPending       Int           @default(0)
  employeeIssuesResolved Int           @default(0)
  remarks                String?
}

model DeveloperMonthlyReportDetail {
  id                    String        @id @default(cuid())
  monthlyReportId       String        @unique
  monthlyReport         MonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  tasksAssigned         Int           @default(0)
  tasksCompleted        Int           @default(0)
  tasksPending          Int           @default(0)
  bugsAssigned          Int           @default(0)
  bugsResolved          Int           @default(0)
  projectsWorkedOn      Int           @default(0)
  deploymentsCompleted  Int           @default(0)
  onTimeDeliveryPercent Float?
  remarks               String?
}

model PayrollMonthlyReportDetail {
  id                  String        @id @default(cuid())
  monthlyReportId     String        @unique
  monthlyReport       MonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  employeesProcessed  Int           @default(0)
  payrollCompleted    Int           @default(0)
  payrollErrors       Int           @default(0)
  correctionsRequired Int           @default(0)
  payslipsGenerated   Int           @default(0)
  payslipsPending     Int           @default(0)
  employeeQueries     Int           @default(0)
  queriesResolved     Int           @default(0)
  pfStatus            String
  esiStatus           String
  tdsStatus           String
  remarks             String?
}

model MonthlyReportAttachment {
  id              String               @id @default(cuid())
  riskId          String?
  risk            RiskAssessment?      @relation(fields: [riskId], references: [id], onDelete: Cascade)
  monthlyReportId String?
  monthlyReport   MonthlyReport?       @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  auditId         String?
  audit           InternalAudit?       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  findingId       String?
  finding         AuditFinding?        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  capaId          String?
  capa            Capa?                @relation(fields: [capaId], references: [id], onDelete: Cascade)
  actionItemId    String?
  actionItem      CapaActionItem?      @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  purpose         String               @default("GENERAL")
  reviewStatus    EvidenceReviewStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?                @relation("EvidenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?            @db.Timestamptz(3)
  reviewComment   String?
  originalName    String
  storedName      String               @unique
  mimeType        String
  size            Int
  uploadedById    String
  uploadedBy      User                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  @@index([monthlyReportId, createdAt])
  @@index([uploadedById])
  @@index([auditId, createdAt])
  @@index([findingId])
  @@index([capaId])
  @@index([actionItemId])
  @@index([reviewedById])
  @@index([riskId, createdAt])
}

model MonthlyReportActionHistory {
  id                String              @id @default(cuid())
  riskId            String?
  risk              RiskAssessment?     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  riskConfigurationId String?
  riskConfiguration RiskScoringConfiguration? @relation(fields: [riskConfigurationId], references: [id], onDelete: Restrict)
  monthlyReportId   String?
  monthlyReport     MonthlyReport?      @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  auditId           String?
  audit             InternalAudit?      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  findingId         String?
  finding           AuditFinding?       @relation(fields: [findingId], references: [id], onDelete: Cascade)
  capaId            String?
  capa              Capa?               @relation(fields: [capaId], references: [id], onDelete: Cascade)
  previousStatus    String?
  newStatus         String?
  action            MonthlyReportAction
  performedByUserId String
  performedByUser   User                @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  comment           String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  @@index([monthlyReportId, createdAt])
  @@index([performedByUserId])
  @@index([auditId, createdAt])
  @@index([findingId])
  @@index([capaId])
  @@index([riskId, createdAt])
  @@index([riskConfigurationId, createdAt])
}

enum RiskStatus {
  OPEN
  MITIGATION_IN_PROGRESS
  MITIGATED
  ACCEPTED
  CLOSED
}

model RiskScoringConfiguration {
  id          String @id @default("default")
  levels      Json
  version     Int @default(1)
  updatedById String?
  updatedBy   User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  history     MonthlyReportActionHistory[]

  @@index([updatedById])
}

model RiskAssessment {
  id                    String @id @default(cuid())
  reference             String @unique
  title                 String
  description           String
  departmentId          String
  department            Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  processActivity       String
  category              String
  hazardSource          String @default("")
  potentialConsequence  String @default("")
  existingControls      String @default("")
  likelihood            Int
  severity              Int
  riskScore             Int
  additionalMitigation  String @default("")
  responsibleEmployeeId String
  responsibleEmployee   Employee @relation(fields: [responsibleEmployeeId], references: [id], onDelete: Restrict)
  targetDate            DateTime? @db.Date
  completionDate        DateTime? @db.Date
  residualLikelihood    Int?
  residualSeverity      Int?
  residualRiskScore     Int?
  status                RiskStatus @default(OPEN)
  reviewDate            DateTime @db.Date
  comments              String @default("")
  auditId               String?
  audit                 InternalAudit? @relation(fields: [auditId], references: [id], onDelete: Restrict)
  findingId             String?
  finding               AuditFinding? @relation(fields: [findingId], references: [id], onDelete: Restrict)
  capaId                String?
  capa                  Capa? @relation(fields: [capaId], references: [id], onDelete: Restrict)
  createdById           String
  createdBy             User @relation("RiskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById          String?
  reviewedBy            User? @relation("RiskReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt            DateTime? @db.Timestamptz(3)
  closedById            String?
  closedBy              User? @relation("RiskCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt              DateTime? @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  evidence              MonthlyReportAttachment[]
  history               MonthlyReportActionHistory[]

  @@index([departmentId, status])
  @@index([responsibleEmployeeId, status])
  @@index([status, targetDate])
  @@index([status, reviewDate])
  @@index([riskScore])
  @@index([category, status])
  @@index([auditId])
  @@index([findingId])
  @@index([capaId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([closedById])
  @@index([createdAt])
}

enum InternalAuditStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  AUDIT_COMPLETED
  FINDINGS_ISSUED
  CAPA_PENDING
  CAPA_UNDER_REVIEW
  VERIFICATION_PENDING
  CLOSED
  CANCELLED
}

enum AuditFindingStatus {
  OPEN
  CAPA_PENDING
  UNDER_REVIEW
  ACTION_IN_PROGRESS
  VERIFICATION_PENDING
  CLOSED
}

enum CapaStatus {
  OPEN
  RCA_PENDING
  PREPARATION
  SUBMITTED
  UNDER_REVIEW
  ACTION_IN_PROGRESS
  VERIFICATION_PENDING
  VERIFIED
  CLOSED
  RETURNED
}

enum CapaActionType {
  CONTAINMENT
  CORRECTIVE
  PREVENTIVE
}

enum CapaActionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFICATION_PENDING
  VERIFIED
  REJECTED
}

enum EvidenceReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model AuditCounter {
  key   String @id
  value Int    @default(0)
}

model FindingRating {
  code     String         @id
  label    String
  severity Int            @default(0)
  isActive Boolean        @default(true)
  findings AuditFinding[]
}

model InternalAudit {
  id                     String                       @id @default(cuid())
  reference              String                       @unique
  title                  String
  organisation           String
  departmentId           String
  department             Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  auditorId              String
  auditor                User                         @relation("AuditLead", fields: [auditorId], references: [id], onDelete: Restrict)
  createdById            String
  createdBy              User                         @relation("AuditCreator", fields: [createdById], references: [id], onDelete: Restrict)
  auditDate              DateTime?                    @db.Date
  scope                  String                       @default("")
  auditType              String                       @default("INTERNAL")
  location               String                       @default("")
  standardReference      String                       @default("RBA")
  status                 InternalAuditStatus          @default(DRAFT)
  capaPreparationDueDate DateTime?                    @db.Date
  findingsIssuedAt       DateTime?                    @db.Timestamptz(3)
  closedAt               DateTime?                    @db.Timestamptz(3)
  findingSequence        Int                          @default(0)
  sourceDocument         String?
  sourceImportKey        String?                      @unique
  teamMembers            AuditTeamMember[]
  findings               AuditFinding[]
  evidence               MonthlyReportAttachment[]
  history                MonthlyReportActionHistory[]
  risks                  RiskAssessment[]
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(3)

  @@index([departmentId, status, auditDate])
  @@index([auditorId, status])
  @@index([createdById])
  @@index([status, auditDate])
}

model AuditTeamMember {
  auditId String
  audit   InternalAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([auditId, userId])
  @@index([userId])
}

model AuditFinding {
  id                    String                       @id @default(cuid())
  reference             String                       @unique
  auditId               String
  audit                 InternalAudit                @relation(fields: [auditId], references: [id], onDelete: Cascade)
  rbaSection            String
  rbaReference          String
  ratingCode            String
  rating                FindingRating                @relation(fields: [ratingCode], references: [code], onDelete: Restrict)
  description           String
  departmentId          String
  department            Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  responsibleEmployeeId String?
  responsibleEmployee   Employee?                    @relation(fields: [responsibleEmployeeId], references: [id], onDelete: Restrict)
  status                AuditFindingStatus           @default(OPEN)
  sourceModule          String?
  sourceRecordId        String?
  closedAt              DateTime?                    @db.Timestamptz(3)
  capa                  Capa?
  evidence              MonthlyReportAttachment[]
  history               MonthlyReportActionHistory[]
  risks                 RiskAssessment[]
  createdAt             DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @db.Timestamptz(3)

  @@unique([auditId, sourceModule, sourceRecordId])
  @@index([auditId, status])
  @@index([departmentId, status])
  @@index([responsibleEmployeeId, status])
  @@index([ratingCode, status])
  @@index([sourceModule, sourceRecordId])
}

model Capa {
  risks                 RiskAssessment[]
  id                 String                       @id @default(cuid())
  reference          String                       @unique
  findingId          String                       @unique
  finding            AuditFinding                 @relation(fields: [findingId], references: [id], onDelete: Cascade)
  status             CapaStatus                   @default(OPEN)
  rcaMethod          String                       @default("STANDARD")
  rootCause          String                       @default("")
  problemStatement   String                       @default("")
  why1               String                       @default("")
  why2               String                       @default("")
  why3               String                       @default("")
  why4               String                       @default("")
  why5               String                       @default("")
  finalRootCause     String                       @default("")
  containmentAction  String                       @default("")
  correctiveAction   String                       @default("")
  preventiveAction   String                       @default("")
  dateEstablished    DateTime                     @default(now()) @db.Date
  startDate          DateTime?                    @db.Date
  targetDate         DateTime?                    @db.Date
  implementationDays Int?
  completionDate     DateTime?                    @db.Date
  preparedById       String?
  preparedBy         User?                        @relation("CapaPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  reviewedById       String?
  reviewedBy         User?                        @relation("CapaReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  verifiedById       String?
  verifiedBy         User?                        @relation("CapaVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  closedById         String?
  closedBy           User?                        @relation("CapaCloser", fields: [closedById], references: [id], onDelete: Restrict)
  submittedAt        DateTime?                    @db.Timestamptz(3)
  reviewedAt         DateTime?                    @db.Timestamptz(3)
  verifiedAt         DateTime?                    @db.Timestamptz(3)
  closedAt           DateTime?                    @db.Timestamptz(3)
  auditorStatus      String                       @default("NOT_REVIEWED")
  auditorComments    String                       @default("")
  verificationResult String                       @default("")
  actions            CapaActionItem[]
  evidence           MonthlyReportAttachment[]
  verifications      CapaVerification[]
  history            MonthlyReportActionHistory[]
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(3)

  @@index([status, targetDate])
  @@index([preparedById])
  @@index([reviewedById])
  @@index([verifiedById])
  @@index([closedById])
}

model CapaActionItem {
  id              String                    @id @default(cuid())
  capaId          String
  capa            Capa                      @relation(fields: [capaId], references: [id], onDelete: Cascade)
  actionType      CapaActionType
  description     String
  ownerEmployeeId String
  ownerEmployee   Employee                  @relation(fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  departmentId    String
  department      Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  startDate       DateTime                  @db.Date
  targetDate      DateTime                  @db.Date
  completionDate  DateTime?                 @db.Date
  status          CapaActionStatus          @default(NOT_STARTED)
  comments        String                    @default("")
  verifiedById    String?
  verifiedBy      User?                     @relation("ActionVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt      DateTime?                 @db.Timestamptz(3)
  evidence        MonthlyReportAttachment[]
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([capaId, status])
  @@index([ownerEmployeeId, status, targetDate])
  @@index([departmentId, status])
  @@index([verifiedById])
  @@index([status, targetDate])
}

model CapaVerification {
  id            String               @id @default(cuid())
  capaId        String
  capa          Capa                 @relation(fields: [capaId], references: [id], onDelete: Cascade)
  result        EvidenceReviewStatus
  comment       String
  evidenceIds   Json                 @default("[]")
  performedById String
  performedBy   User                 @relation(fields: [performedById], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  @@index([capaId, createdAt])
  @@index([performedById])
}

model PortalNotification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  dedupeKey   String
  title       String
  message     String
  href        String
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

enum QuarterlyReportStatus {
  DRAFT
  SUBMITTED
  MANAGER_REVIEWED
  RETURNED
  FINALIZED
}

enum KpiUnitType {
  NUMBER
  PERCENTAGE
  BOOLEAN
  RATING
  TEXT
}

enum QuarterlyReportAction {
  CREATED
  UPDATED
  SUBMITTED
  RETURNED
  MANAGER_REVIEWED
  FINALIZED
}

model Kpi {
  id              String              @id @default(cuid())
  name            String
  code            String              @unique
  description     String?
  departmentId    String?
  department      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isCommon        Boolean             @default(false)
  unitType        KpiUnitType
  weightage       Decimal             @db.Decimal(5, 2)
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  quarterlyScores QuarterlyKpiScore[]
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  @@index([departmentId, isActive, sortOrder])
  @@index([isCommon, isActive])
}

model PerformanceRatingRange {
  id        String   @id @default(cuid())
  name      String   @unique
  minScore  Decimal  @db.Decimal(5, 2)
  maxScore  Decimal  @db.Decimal(5, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive, sortOrder])
}

model QuarterlyReport {
  id                  String                         @id @default(cuid())
  employeeId          String
  employee            Employee                       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  quarter             Quarter
  year                Int
  status              QuarterlyReportStatus          @default(DRAFT)
  summary             String
  majorAchievements   String
  majorChallenges     String
  nextQuarterFocus    String
  employeeComments    String?
  managerComments     String?
  hrComments          String?
  monthlyReport1Id    String?
  monthlyReport1      MonthlyReport?                 @relation("QuarterlyMonth1", fields: [monthlyReport1Id], references: [id], onDelete: SetNull)
  monthlyReport2Id    String?
  monthlyReport2      MonthlyReport?                 @relation("QuarterlyMonth2", fields: [monthlyReport2Id], references: [id], onDelete: SetNull)
  monthlyReport3Id    String?
  monthlyReport3      MonthlyReport?                 @relation("QuarterlyMonth3", fields: [monthlyReport3Id], references: [id], onDelete: SetNull)
  employeeSubmittedAt DateTime?                      @db.Timestamptz(3)
  managerReviewedAt   DateTime?                      @db.Timestamptz(3)
  hrReviewedAt        DateTime?                      @db.Timestamptz(3)
  finalizedAt         DateTime?                      @db.Timestamptz(3)
  managerReviewedById String?
  managerReviewedBy   User?                          @relation("QuarterlyManagerReviewer", fields: [managerReviewedById], references: [id], onDelete: SetNull)
  hrReviewedById      String?
  hrReviewedBy        User?                          @relation("QuarterlyHrReviewer", fields: [hrReviewedById], references: [id], onDelete: SetNull)
  overallScore        Decimal?                       @db.Decimal(5, 2)
  finalRating         String?
  kpiScores           QuarterlyKpiScore[]
  history             QuarterlyReportActionHistory[]
  createdAt           DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                       @updatedAt @db.Timestamptz(3)

  @@unique([employeeId, quarter, year])
  @@index([status, year, quarter])
  @@index([monthlyReport1Id])
  @@index([monthlyReport2Id])
  @@index([monthlyReport3Id])
  @@index([managerReviewedById])
  @@index([hrReviewedById])
}

model QuarterlyKpiScore {
  id                String          @id @default(cuid())
  quarterlyReportId String
  quarterlyReport   QuarterlyReport @relation(fields: [quarterlyReportId], references: [id], onDelete: Cascade)
  kpiId             String
  kpi               Kpi             @relation(fields: [kpiId], references: [id], onDelete: Restrict)
  targetValue       String?
  actualValue       String?
  score             Decimal         @default(0) @db.Decimal(5, 2)
  weightageSnapshot Decimal         @db.Decimal(5, 2)
  weightedScore     Decimal         @default(0) @db.Decimal(7, 2)
  managerComment    String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([quarterlyReportId, kpiId])
  @@index([kpiId])
}

model QuarterlyReportActionHistory {
  id                String                @id @default(cuid())
  quarterlyReportId String
  quarterlyReport   QuarterlyReport       @relation(fields: [quarterlyReportId], references: [id], onDelete: Cascade)
  action            QuarterlyReportAction
  performedByUserId String
  performedByUser   User                  @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  comment           String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  @@index([quarterlyReportId, createdAt])
  @@index([performedByUserId])
}
